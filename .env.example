# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# The .gitignore file will prevent accidental commits

# ============================================================================
# API KEYS (Get these from service providers)
# ============================================================================

# OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Anthropic API Key (https://console.anthropic.com/api_keys)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq API Key (https://console.groq.com/keys)
# GROQ_API_KEY=gsk-...

# Cohere API Key (https://dashboard.cohere.com/api-keys)
# COHERE_API_KEY=...

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database host
# DB_HOST=localhost

# Database port
# DB_PORT=5432

# Database username
# DB_USER=admin

# Database password
# DB_PASSWORD=your-secure-password

# Database name
# DB_NAME=jafar_kg

# ============================================================================
# APPLICATION PATHS
# ============================================================================

# Coding workspace directory
# CODING_WORKSPACE_DIR=./workspace

# Data directory for database and logs
# DATA_DIR=./data

# Books directory
# BOOKS_DIR=./books

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Provider: openai, anthropic, groq, cohere, local
# LLM_PROVIDER=local

# GGUF Model path for local inference
# GGUF_MODEL_PATH=/path/to/model.gguf

# Llama Server configuration
# LLAMA_SERVER_HOST=localhost
# LLAMA_SERVER_PORT=8000
# LLAMA_MODEL_PATH=/path/to/model.gguf
# LLAMA_THREADS=4

# ============================================================================
# LLAMA SERVER (for local inference)
# ============================================================================

# Llama server host
# LLAMA_SERVER_HOST=localhost

# Llama server port
# LLAMA_SERVER_PORT=8000

# ============================================================================
# SECURITY
# ============================================================================

# Secret key for session management (change in production!)
# SECRET_KEY=your-secret-key-here-change-in-production

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Enable debug mode
# DEBUG=False

# Enable development mode
# DEVELOPMENT=False
